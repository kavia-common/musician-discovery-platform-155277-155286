# Example environment configuration for musician marketplace frontend
# Do NOT check in sensitive values to version control.
# Copy this file to ".env" and provide real values as needed.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL:
# The base URL of the backend REST API. When not provided, the app uses a localStorage-backed mock API.
REACT_APP_API_BASE_URL=https://api.example.com
